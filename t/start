#!/bin/bash

# t/start

# Set script to exit on error
set -e

# Note: trap should be set early to kill the backend process when the script exits
trap 'kill $(jobs -p) 2>/dev/null' EXIT

echo "🚀 Starting services..."

# Start backend server
echo "🐍 Starting Python backend..."
cd backend

# Detect OS and set correct venv paths (Windows uses Scripts/, Unix uses bin/)
if [ -d "venv/Scripts" ]; then
    VENV_ACTIVATE="venv/Scripts/activate"
else
    VENV_ACTIVATE="venv/bin/activate"
fi

source "$VENV_ACTIVATE"

# Use python -m uvicorn for cross-platform compatibility
# (direct 'uvicorn' command may not be in PATH on Windows/Git Bash)
python -m uvicorn main:app --reload --host 0.0.0.0 --port 8000 & # The & runs it in the background

# Go back to root and start frontend
echo "⚛️  Starting React frontend..."
cd ..
yarn dev
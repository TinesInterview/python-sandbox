#!/bin/sh
# t/start - macOS, Linux, Git Bash, WSL. (Windows: use t\start.cmd)
#
# Finds Python, then hands over to t/start.py, which does the real work.

if command -v python3 >/dev/null 2>&1; then
    exec python3 "$(dirname "$0")/start.py" "$@"
fi

echo "Could not find python3 on your PATH." >&2
echo "Install Python 3, e.g. 'brew install python' or 'sudo apt install python3 python3-venv'." >&2
exit 1
